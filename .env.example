# HUGO Eye configuration (copy to .env and fill in; .env is gitignored, keep it chmod 600)

# --- Server ---
HUGO_EYE_HOST=127.0.0.1        # bind address; use a LAN IP only on trusted networks
HUGO_EYE_PORT=8764
HUGO_EYE_API_TOKEN=            # random hex, e.g. openssl rand -hex 32 (required)

# --- Storage ---
HUGO_EYE_DATA_DIR=/home/dev/hugo-eye-data   # database + media live here

# --- Camera 1 (camera driver instances are CAM1..CAMn; add CAM2_* for the next camera) ---
CAM1_ID=tapo-main
CAM1_DRIVER=tapo
CAM1_NAME=Living room
CAM1_MODEL=TP-Link Tapo C520WS
CAM1_HOST=192.168.1.64       # historical observation — verify before first run
CAM1_RTSP_PORT=554
CAM1_ONVIF_PORT=2020
CAM1_RTSP_MAIN_PATH=/stream1   # high quality, used for snapshots
CAM1_RTSP_SUB_PATH=/stream2    # lightweight, used for live preview
CAM1_USERNAME=                 # local camera account (created in the Tapo app)
CAM1_PASSWORD=
CAM1_ROTATE=0                  # initial picture rotation: 0/90/180/270 (180 = inverted ceiling mount)

# --- Patrol (automatic preset timelapse). Starts disabled by default. ---
PATROL_ENABLED=false
PATROL_SETTLE_MS=2500
PATROL_TICK_MS=60000
PATROL_LIMIT=12

# --- Health monitoring ---
HEALTH_INTERVAL_MS=30000
